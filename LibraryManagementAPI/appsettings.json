{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=APILibraryDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "JWT": {
    "ValidIssuer": "LibraryAPI",
    "ValidAudience": "LibraryAPIUsers",
    "Secret": "",
    "ExpiryHours": 3,
    "RefreshTokenDays": 7
  },

  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Loans": {
    "LoanPeriodDays": 14,
    "MaxActiveLoansPerUser": 5
  },

  "SeedAdmin": {
    "Email": "admin@library.com",
    "Password": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
